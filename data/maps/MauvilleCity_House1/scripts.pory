script MauvilleCity_GameCorner_EventScript_ReactionGame {
 lockall
    checkitem(ITEM_COIN_CASE)
    if (var(VAR_RESULT) == FALSE) {
        msgbox("You can't play if you don't have a COIN CASE.", MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox("It's a REACTION GAME!\nWant to test your reflexes?", MSGBOX_YESNO)
    closemessage
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    callnative(StartReactionGame)
    waitstate
    releaseall
    end
}