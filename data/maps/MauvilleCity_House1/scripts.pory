raw `
MauvilleCity_House1_MapScripts::
	.byte 0

MauvilleCity_House1_EventScript_RockSmashDude::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_HM_ROCK_SMASH, MauvilleCity_House1_EventScript_ReceivedRockSmash
	msgbox MauvilleCity_House1_Text_ImRockSmashDudeTakeThis, MSGBOX_DEFAULT
	giveitem ITEM_HM_ROCK_SMASH
	setflag FLAG_RECEIVED_HM_ROCK_SMASH
	setflag FLAG_HIDE_ROUTE_111_ROCK_SMASH_TIP_GUY
	msgbox MauvilleCity_House1_Text_ExplainRockSmash, MSGBOX_DEFAULT
	release
	end

MauvilleCity_House1_EventScript_ReceivedRockSmash::
	msgbox MauvilleCity_House1_Text_MonCanFlyOutOfSmashedRock, MSGBOX_DEFAULT
	release
	end

MauvilleCity_House1_Text_ImRockSmashDudeTakeThis:
	.string "Woohoo!\p"
	.string "I hear people call me the ROCK SMASH\n"
	.string "GUY, but I find that sort of degrading.\p"
	.string "I think I deserve a bit more respect,\n"
	.string "like maybe the ROCK SMASH DUDE.\p"
	.string "Woohoo!\p"
	.string "Anyways, your POKéMON look pretty\n"
	.string "strong.\p"
	.string "I like that!\n"
	.string "Here, take this HIDDEN MACHINE!$"

MauvilleCity_House1_Text_ExplainRockSmash:
	.string "That HM contains ROCK SMASH.\p"
	.string "If you come across large boulders\n"
	.string "that block your path…\p"
	.string "Well, use that HM move and smash\n"
	.string "them right out of your way!\p"
	.string "Yes, sir! Smash rocks aside, I say!\n"
	.string "Woohoo!$"

MauvilleCity_House1_Text_MonCanFlyOutOfSmashedRock:
	.string "Oh, yes, if you smash a rock, a POKéMON\n"
	.string "could come flying out of hiding.\p"
	.string "Woohoo!$"



`
script coincase {
    lockall
    faceplayer
	if (flag(FLAG_UNUSED_0x2BB)) {
    msgbox("You already have a coinbox.", MSGBOX_DEFAULT)
		closemessage
		release
		end
}
	
	else {
		giveitem (ITEM_COIN_CASE ,1)
	closemessage
	showcoinsbox (10, 3)
	waitbuttonpress
	addcoins (9999)
	updatecoinsbox (10, 3)
	waitbuttonpress
	hidecoinsbox (10, 3)
	showmonpic (SPECIES_SCREAM_TAIL, 10, 3)
	givemon (SPECIES_SCREAM_TAIL, 10, 0)
	setflag (FLAG_UNUSED_0x2BB)
	setflag (FLAG_SYS_POKEMON_GET)
	setflag (FLAG_SYS_POKEDEX_GET)
	setflag (FLAG_SYS_NATIONAL_DEX)
	waitbuttonpress
	hidemonpic
	dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Charmander", "Bulbasaur", "Squirtle", "Pikachu")
	if (var(VAR_RESULT) == 0) {
    showmonpic (SPECIES_CHARMANDER, 10, 3)
	msgbox(format("Would you like the fire Pokemon, Charmander?"), MSGBOX_DEFAULT)
	hidemonpic
	dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
	if (var(VAR_RESULT) == 0) {
		playmoncry (SPECIES_CHARMANDER, CRY_MODE_NORMAL)
		waitmoncry
		givemon (SPECIES_CHARMANDER, 10, 0)
		msgbox("Received Charmander!", MSGBOX_DEFAULT)		
    closemessage
    release
    end}
	else
	{
		msgbox(format("Oh, you don't want Charmander?"), MSGBOX_DEFAULT)
		closemessage
		releaseall
		end
	}
}
elif (var(VAR_RESULT) == 1) {
	showmonpic (SPECIES_BULBASAUR, 10, 3)
	msgbox(format("Would you like the grass Pokemon, Bulbasaur?"), MSGBOX_DEFAULT)
	hidemonpic
	dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
	if (var(VAR_RESULT) == 0) {
		playmoncry (SPECIES_BULBASAUR, CRY_MODE_NORMAL)
		waitmoncry
		givemon (SPECIES_BULBASAUR, 10, 0)
		msgbox("Received Bulbasaur!", MSGBOX_DEFAULT)		
    closemessage
    release
    end}
	else
	{
		msgbox(format("Oh, you don't want Bulbasaur?"), MSGBOX_DEFAULT)
		closemessage
		releaseall
		end
	}
}
elif (var(VAR_RESULT) == 2) {
	showmonpic (SPECIES_SQUIRTLE, 10, 3)
	msgbox(format("Would you like the water Pokemon, Squirtle?"), MSGBOX_DEFAULT)
	hidemonpic
	dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
	if (var(VAR_RESULT) == 0) {
		playmoncry (SPECIES_SQUIRTLE, CRY_MODE_NORMAL)
		waitmoncry
		msgbox("Received Squirtle!", MSGBOX_DEFAULT)		
    closemessage
    release
    end}
	else
	{
		msgbox(format("Oh, you don't want Squirtle?"), MSGBOX_DEFAULT)
		closemessage
		releaseall
		end
	}
}
elif (var(VAR_RESULT) == 3) {
	showmonpic (SPECIES_PIKACHU, 10, 3)
	msgbox(format("Would you like the electric Pokemon, Pikachu?"), MSGBOX_DEFAULT)
	hidemonpic
	dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
	if (var(VAR_RESULT) == 0) {
		playmoncry (SPECIES_PIKACHU, CRY_MODE_NORMAL)
		waitmoncry
		msgbox("Received Pikachu!", MSGBOX_DEFAULT)		
    closemessage
    release
    end}
	else
	{
		msgbox(format("Oh, you don't want Pikachu?"), MSGBOX_DEFAULT)
		closemessage
		releaseall
		end
	}
}
	}
}
		

// ---------- Main entry script ----------
script PokemonCoinShop {
    goto (PokemonCoinShop_RegionMenu)
}

// ---------- Region selection menu ----------
script PokemonCoinShop_RegionMenu {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Welcome to the Pokémon Coin Shop!\nWhich region's Pokémon would you like to see?"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Kanto", "Johto", "Hoenn")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 0: // Kanto
            hidecoinsbox (10, 3)
            goto (PokemonCoinShop_Kanto)
        case 1: // Johto
            hidecoinsbox (10, 3)
            goto (PokemonCoinShop_Johto)
        case 2: // Hoenn
            hidecoinsbox (10, 3)
            goto (PokemonCoinShop_Hoenn)
    }
}

// ---------- Kanto page ----------
script PokemonCoinShop_Kanto {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Here are some Kanto Pokémon!"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
        "Charmander", "Bulbasaur", "Squirtle", "Pikachu", "Back")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 4: // Back -> Region menu
            hidecoinsbox (10, 3)
            goto (PokemonCoinShop_RegionMenu)
        default:
            if (var(VAR_RESULT) == 0) {
                // Charmander
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 500) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!\nCome back after making space."), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_CHARMANDER, 4, 3)
                    msgbox(format("Would you like to buy Charmander for 500 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (500)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_CHARMANDER, 50, ITEM_NONE)
                        playmoncry (SPECIES_CHARMANDER, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Charmander!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind? Come back if you do."), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
                } else {
                    msgbox(format("You need 500 coins!"), MSGBOX_DEFAULT)
                }
                hidecoinsbox (10, 3)
                release
                end
            }
            if (var(VAR_RESULT) == 1) {
                // Bulbasaur
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 500) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!"), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_BULBASAUR, 4, 3)
                    msgbox(format("Would you like to buy Bulbasaur for 500 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (500)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_BULBASAUR, 50, ITEM_NONE)
                        playmoncry (SPECIES_BULBASAUR, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Bulbasaur!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind?"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
                } else {
                    msgbox(format("You need 500 coins!"), MSGBOX_DEFAULT)
                }
                hidecoinsbox (10, 3)
                release
                end
            }
            if (var(VAR_RESULT) == 2) {
                // Squirtle
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 500) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!"), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_SQUIRTLE, 4, 3)
                    msgbox(format("Would you like to buy Squirtle for 500 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (500)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_SQUIRTLE, 50, ITEM_NONE)
                        playmoncry (SPECIES_SQUIRTLE, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Squirtle!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind?"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
                } else {
                    msgbox(format("You need 500 coins!"), MSGBOX_DEFAULT)
                }
                hidecoinsbox (10, 3)
                release
                end
            }
            if (var(VAR_RESULT) == 3) {
                // Pikachu
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 500) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!"), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_PIKACHU, 4, 3)
                    msgbox(format("Would you like to buy Pikachu for 500 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (500)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_PIKACHU, 50, ITEM_NONE)
                        playmoncry (SPECIES_PIKACHU, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Pikachu!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind?"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
                } else {
                    msgbox(format("You need 500 coins!"), MSGBOX_DEFAULT)
                }
                hidecoinsbox (10, 3)
                release
                end
            }
    }
}

