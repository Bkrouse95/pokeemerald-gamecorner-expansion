// ---------- Main entry script for Regional Merchant ----------
script PokemonRegionalShop {
    goto (PokemonRegionalShop_RegionMenu)
}

// ---------- Region selection menu ----------
script PokemonRegionalShop_RegionMenu {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Welcome to the Regional Pokémon Shop!\nThese Pokémon come from distant regions.\nWhich region would you like to browse?"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Galar", "Hisui", "Alola")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 0: // Galar
            hidecoinsbox (10, 3)
            goto (PokemonRegionalShop_Galar)
        case 1: // Hisui
            hidecoinsbox (10, 3)
            goto (PokemonRegionalShop_Hisui)
        case 2: // Alola
            hidecoinsbox (10, 3)
            goto (PokemonRegionalShop_Alola)
    }
}

