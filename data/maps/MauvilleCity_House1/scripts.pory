// ---------- Main entry script for Variant Merchant ----------
script PokemonVariantShop {
    goto (PokemonVariantShop_RegionMenu)
}

// ---------- Region selection menu ----------
script PokemonVariantShop_RegionMenu {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Welcome to the Regional Variant Shop!\nThese Pokémon have unique forms from different regions.\nWhich region's variants would you like to browse?"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Alolan Forms", "Galarian Forms", "Hisuian Forms")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 0: // Alolan Forms
            hidecoinsbox (10, 3)
            goto (PokemonVariantShop_Alola)
        case 1: // Galarian Forms
            hidecoinsbox (10, 3)
            goto (PokemonVariantShop_Galar)
        case 2: // Hisuian Forms
            hidecoinsbox (10, 3)
            goto (PokemonVariantShop_Hisui)
    }
}

// ---------- Alolan Forms page ----------
script PokemonVariantShop_Alola {
    lockall
