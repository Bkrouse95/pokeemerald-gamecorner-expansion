// ---------- Main entry script for Legendary Merchant ----------
script PokemonLegendShop {
    goto (PokemonLegendShop_RegionMenu)
}

// ---------- Region selection menu ----------
script PokemonLegendShop_RegionMenu {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Welcome to the Legendary Pokémon Shop!\nThese rare Pokémon require more coins.\nWhich region would you like to browse?"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Kanto Legends", "Johto Legends", "Hoenn Legends")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 0: // Kanto Legends
            hidecoinsbox (10, 3)
            goto (PokemonLegendShop_Kanto)
        case 1: // Johto Legends
            hidecoinsbox (10, 3)
            goto (PokemonLegendShop_Johto)
        case 2: // Hoenn Legends
            hidecoinsbox (10, 3)
            goto (PokemonLegendShop_Hoenn)
    }
}

// ---------- Kanto Legends page ----------
script PokemonLegendShop_Kanto {
    lockall
    faceplayer
    showcoinsbox (16, 3)

    msgbox(format("Kanto Legendary & Competitive Pokémon!"), MSGBOX_DEFAULT)
    dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
        "Mewtwo (2000)", "Mew (2500)", "Dragonite (1000)", "Gengar (800)", "Snorlax (800)", "Back")

    switch (var(VAR_RESULT)) {
        case 127: // B pressed
            msgbox(format("Come back anytime!"), MSGBOX_DEFAULT)
            hidecoinsbox (10, 3)
            release
            end
        case 5: // Back -> Region menu
            hidecoinsbox (10, 3)
            goto (PokemonLegendShop_RegionMenu)
        default:
            if (var(VAR_RESULT) == 0) {
                // Mewtwo - 2000 coins
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 2000) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!\nCome back after making space."), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_MEWTWO, 4, 3)
                    msgbox(format("Would you like to buy Mewtwo for 2000 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (2000)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_MEWTWO, 50, ITEM_NONE)
                        playmoncry (SPECIES_MEWTWO, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Mewtwo!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind? Come back if you do."), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
