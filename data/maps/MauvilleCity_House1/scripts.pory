                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!"), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
                    showmonpic (SPECIES_MUK_ALOLA, 4, 3)
                    msgbox(format("Would you like to buy Alolan Muk for 700 coins?"), MSGBOX_DEFAULT)
                    hidemonpic
                    dynmultichoice(12, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")
                    if (var(VAR_RESULT) == 0) {
                        removecoins (700)
                        updatecoinsbox (10, 3)
                        givemon (SPECIES_MUK_ALOLA, 50, ITEM_NONE)
                        playmoncry (SPECIES_MUK_ALOLA, CRY_MODE_NORMAL)
                        waitmoncry
                        msgbox(format("You received Alolan Muk!"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    } else {
                        msgbox(format("Changed your mind?"), MSGBOX_DEFAULT)
                        waitbuttonpress
                    }
                } else {
                    msgbox(format("You need 700 coins!"), MSGBOX_DEFAULT)
                }
                hidecoinsbox (10, 3)
                release
                end
            }
            if (var(VAR_RESULT) == 4) {
                // Alolan Exeggutor - 700 coins
                checkcoins (VAR_TEMP_0)
                if (var(VAR_TEMP_0) >= 700) {
                    getpartysize
                    if (var(VAR_RESULT) == 6) {
                        msgbox(format("Your party is full!"), MSGBOX_DEFAULT)
                        hidecoinsbox (10, 3)
                        release
                        end
                    }
